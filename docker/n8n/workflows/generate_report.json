    {
      "parameters": {
        "query": "INSERT INTO reports (report_name, generated_at, asset_count, finding_count, critical, high, medium, low, file_path) VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING id;",
        "values": [
          "={{ $json.report_name }}",
          "={{ $json.generated_at }}",
          "={{ $json.stats.total_assets }}",
          "={{ $json.summary.total_findings }}",
          "={{ $json.summary.critical }}",
          "={{ $json.summary.high }}",
          "={{ $json.summary.medium }}",
          "={{ $json.summary.low }}",
          "=/app/reports/{{ $json.report_name }}.pdf"
        ]
      },
