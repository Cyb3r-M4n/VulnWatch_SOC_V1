# ============================================
# VulnWatch SOC - Configuration
# ============================================

# PostgreSQL (données applicatives)
POSTGRES_DB=vulnwatch
POSTGRES_USER=vulnwatch
POSTGRES_PASSWORD=ChangeMe123!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port exposé sur l'hôte (évite conflit avec Postgres local)
POSTGRES_HOST_PORT=5433

# Wazuh manager (inventaire Syscollector uniquement — pas d'indexer)
# Mot de passe API : 8+ car. avec majuscule, minuscule, chiffre, symbole
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=ChangeMeWazuhApi1!
WAZUH_ENROLL_PASSWORD=ChangeMeWazuhEnroll1!
WAZUH_AGENT_PORT=1514
WAZUH_ENROLL_PORT=1515
WAZUH_API_HOST_PORT=55000

# n8n
N8N_PORT=5678
N8N_ENCRYPTION_KEY=ChangeMeEncryptionKey32chars!!
N8N_HOST=localhost
N8N_PROTOCOL=http

# Engine
ENGINE_PORT=8000
ENGINE_SECRET_KEY=ChangeMeSecretKey
ENGINE_DEBUG=true

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMeGrafanaAdmin!

# NVD API (obligatoire en prod — https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=your_nvd_api_key_here

# Email — réservé V2 (non utilisé en V1)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# Timezone
TZ=Europe/Paris
