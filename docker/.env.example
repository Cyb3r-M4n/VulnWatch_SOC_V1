# ============================================
# VulnWatch SOC - Configuration
# ============================================

# PostgreSQL (données applicatives)
POSTGRES_DB=vulnwatch
POSTGRES_USER=vulnwatch
POSTGRES_PASSWORD=ChangeMe123!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port exposé sur l'hôte (évite conflit avec Postgres local)
POSTGRES_HOST_PORT=5433

# MySQL (Fleet uniquement)
MYSQL_DATABASE=fleet
MYSQL_USER=fleet
MYSQL_PASSWORD=ChangeMeFleetDb123!
MYSQL_ROOT_PASSWORD=ChangeMeFleetRoot123!
MYSQL_HOST_PORT=3307

# Fleet
FLEET_URL=http://fleet:8080
FLEET_TOKEN=ChangeMeFleetToken123!
FLEET_PORT=8080

# n8n
N8N_PORT=5678
N8N_ENCRYPTION_KEY=ChangeMeEncryptionKey32chars!!
N8N_HOST=localhost
N8N_PROTOCOL=http

# Engine
ENGINE_PORT=8000
ENGINE_SECRET_KEY=ChangeMeSecretKey
ENGINE_DEBUG=true

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMeGrafanaAdmin!

# NVD API (obligatoire en prod — https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=your_nvd_api_key_here

# URL publique Fleet pour les agents (doc) — n8n utilise FLEET_URL interne
# Exemple LAN : http://192.168.1.81:8080
# FLEET_PUBLIC_URL=http://192.168.1.81:8080

# Email — réservé V2 (non utilisé en V1)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# Timezone
TZ=Europe/Paris
